<div id="settingsContainer" style="display: none;">
    <div id="settingsModalPanel">
        <div id="settingsModalHeader">
            <span id="settingsModalTitle"><%- lang('settings.navHeaderText') %></span>
            <button id="settingsNavDone" aria-label="<%- lang('settings.navDone') %>">&times;</button>
        </div>
        <div id="settingsModalBody">

            <section class="settingsSection">
                <div class="settingsSectionHeader">
                    <div class="settingsSectionIcon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C49A44" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
                    </div>
                    <span class="settingsSectionTitle settingsSectionTitleGrow"><%- lang('settings.navAccount') %></span>
                    <button class="settingsAddAuthAccount" id="settingsAddAzuriomAccount"><%- lang('settings.addAzuriomAccount') %></button>
                </div>
                <div class="settingsCurrentAccounts" id="settingsCurrentAzuriomAccounts">
                    <!-- Azuriom auth accounts populated here. -->
                </div>
            </section>

            <section class="settingsSection">
                <div class="settingsSectionHeader">
                    <div class="settingsSectionIcon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C49A44" stroke-width="2" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"></path><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"></path></svg>
                    </div>
                    <span class="settingsSectionTitle"><%- lang('settings.minecraftTabHeaderText') %></span>
                </div>
                <div class="settingsCard">
                    <div class="settingsCardRow">
                        <div>
                            <div class="settingsFieldTitle"><%- lang('settings.gameResolutionTitle') %></div>
                            <div class="settingsFieldDesc"><%- lang('settings.gameResolutionDesc') %></div>
                        </div>
                        <div id="settingsGameResolutionContent">
                            <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth">
                            <span id="settingsGameResolutionCross">&#10006;</span>
                            <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight">
                        </div>
                    </div>
                    <div class="settingsCardDivider"></div>
                    <label class="settingsCardRow settingsToggleRow">
                        <div>
                            <div class="settingsFieldTitle"><%- lang('settings.launchFullscreenTitle') %></div>
                            <div class="settingsFieldDesc"><%- lang('settings.launchFullscreenDesc') %></div>
                        </div>
                        <span class="toggleSwitch">
                            <input type="checkbox" cValue="Fullscreen">
                            <span class="toggleSwitchSlider"></span>
                        </span>
                    </label>
                </div>
            </section>

            <section class="settingsSection">
                <div class="settingsSectionHeader">
                    <div class="settingsSectionIcon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C49A44" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"></path></svg>
                    </div>
                    <span class="settingsSectionTitle"><%- lang('settings.memoryTitle') %></span>
                </div>
                <div class="settingsMemoryCard">
                    <div id="settingsMemoryContentLeft">
                        <div class="settingsMemoryContentItem">
                            <div class="settingsMemorySliderHead">
                                <span class="settingsMemoryHeader"><%- lang('settings.maxRAM') %></span>
                                <span id="settingsMaxRAMLabel" class="settingsMemoryLabel">3G</span>
                            </div>
                            <div id="settingsMaxRAMRange" class="rangeSlider" cValue="MaxRAM" serverDependent min="3" max="8" value="3" step="0.5" tabindex="0" role="slider" aria-valuemin="3" aria-valuemax="8" aria-label="<%- lang('settings.maxRAM') %>">
                                <div class="rangeSliderBar"></div>
                                <div class="rangeSliderTrack"></div>
                            </div>
                        </div>
                        <div class="settingsMemoryContentItem">
                            <div class="settingsMemorySliderHead">
                                <span class="settingsMemoryHeader"><%- lang('settings.minRAM') %></span>
                                <span id="settingsMinRAMLabel" class="settingsMemoryLabel">3G</span>
                            </div>
                            <div id="settingsMinRAMRange" class="rangeSlider" cValue="MinRAM" serverDependent min="3" max="8" value="3" step="0.5" tabindex="0" role="slider" aria-valuemin="3" aria-valuemax="8" aria-label="<%- lang('settings.minRAM') %>">
                                <div class="rangeSliderBar"></div>
                                <div class="rangeSliderTrack"></div>
                            </div>
                        </div>
                    </div>
                    <div class="settingsCardDivider settingsCardDividerVertical"></div>
                    <div id="settingsMemoryContentRight">
                        <div class="settingsMemoryStatusContainer">
                            <span class="settingsMemoryStatusTitle"><%- lang('settings.memoryTotalTitle') %></span>
                            <span id="settingsMemoryTotal" class="settingsMemoryStatusValue">16G</span>
                        </div>
                        <div class="settingsMemoryStatusContainer">
                            <span class="settingsMemoryStatusTitle"><%- lang('settings.memoryAvailableTitle') %></span>
                            <span id="settingsMemoryAvail" class="settingsMemoryStatusValue">7.3G</span>
                        </div>
                    </div>
                </div>
                <div id="settingsMemoryDesc"><%- lang('settings.memoryDesc') %></div>
            </section>

            <section class="settingsSection">
                <div class="settingsSectionHeader">
                    <div class="settingsSectionIcon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C49A44" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg>
                    </div>
                    <span class="settingsSectionTitle"><%- lang('settings.launcherTabHeaderText') %></span>
                </div>

                <div class="settingsFileSelContainer">
                    <div class="settingsFieldTitle" id="settingsDataDirTitle"><%- lang('settings.dataDirectoryTitle') %></div>
                    <div class="settingsFileSelActions">
                        <input class="settingsFileSelVal" type="text" value="null" cValue="DataDirectory" id="settingsDataDirVal">
                        <button class="settingsFileSelButton" dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true"><%- lang('settings.chooseFolder') %></button>
                    </div>
                    <div class="settingsFileSelDesc"><%- lang('settings.dataDirectoryDesc') %></div>
                </div>

                <div class="settingsCard">
                    <label class="settingsCardRow settingsToggleRow">
                        <div>
                            <div class="settingsFieldTitle"><%- lang('settings.sendCrashReportsTitle') %></div>
                            <div class="settingsFieldDesc"><%- lang('settings.sendCrashReportsDesc') %></div>
                        </div>
                        <span class="toggleSwitch">
                            <input type="checkbox" cValue="SendCrashReports">
                            <span class="toggleSwitchSlider"></span>
                        </span>
                    </label>
                </div>

                <div id="settingsTabUpdate">
                    <div id="settingsUpdateStatusContainer">
                        <div id="settingsUpdateVersionCheck">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                        </div>
                        <div id="settingsUpdateStatusContent">
                            <span id="settingsUpdateTitle"><!-- You Are Running the Latest Version --></span>
                            <div id="settingsUpdateVersionLine">
                                <span id="settingsUpdateVersionTitle"><%- lang('settings.stableRelease') %></span>
                                <span> &middot; </span>
                                <b id="settingsUpdateVersionValue">0.0.1-alpha.18</b>
                            </div>
                        </div>
                        <div id="settingsUpdateActionContainer">
                            <button id="settingsUpdateActionButton"><%- lang('settings.checkForUpdates') %></button>
                        </div>
                    </div>
                    <div class="settingsChangelogContainer">
                        <div class="settingsChangelogContent">
                            <div class="settingsChangelogHeadline">
                                <div class="settingsChangelogLabel"><%- lang('settings.whatsNew') %></div>
                                <div class="settingsChangelogTitle"><%- lang('settings.updateReleaseNotes') %></div>
                            </div>
                            <div class="settingsChangelogText">
                                <%- lang('settings.noReleaseNotes') %>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="settingsAboutButtons">
                    <a href="<%- lang('settings.supportLink') %>" id="settingsAboutSupportButton" class="settingsAboutButton"><%- lang('settings.support') %> &middot; Discord <span class="settingsAboutButtonArrow">&#8599;</span></a>
                </div>
            </section>

        </div>
    </div>
    <script src="./assets/js/scripts/settings.js"></script>
</div>
